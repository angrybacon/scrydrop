{
  "bin": {
    "scrydrop": "./dist/scrydrop.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "name": "@korumite/scrydrop",
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angrybacon/scrydrop.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx ./server",
    "lint": "pnpm run '/^lint:[^:]+$/'",
    "lint:code": "oxlint",
    "lint:format": "prettier --check --log-level warn lib/ server/",
    "lint:prune": "knip",
    "lint:typings": "tsc",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch"
  },
  "dependencies": {
    "plaiceholder": "3.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@korumite/ts": "1.7.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "commander": "15.0.0",
    "knip": "6.34.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
