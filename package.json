{
  "bin": {
    "scrydrop": "./dist/scrydrop.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "name": "@korumite/scrydrop",
  "packageManager": "pnpm@11.5.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angrybacon/scrydrop.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "pnpm run '/^lint:[^:]+$/'",
    "lint:format": "prettier --check --log-level warn lib/ server/",
    "lint:prune": "knip",
    "lint:typings": "tsc",
    "start": "tsx ./server"
  },
  "dependencies": {
    "async-sema": "3.1.1",
    "plaiceholder": "3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@korumite/ts": "1.6.0",
    "@types/node": "25.9.2",
    "commander": "15.0.0",
    "knip": "6.16.0",
    "prettier": "3.8.3",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
